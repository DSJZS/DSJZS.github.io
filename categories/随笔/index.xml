    <item>
      <title>人生总是这样</title>
      <link>https://masterji.top/cn/2026/11/%E4%BA%BA%E7%94%9F%E6%80%BB%E6%98%AF%E8%BF%99%E6%A0%B7/</link>
      <pubDate>Sun, 22 Nov 2026 20:12:48 +0800</pubDate>
      <guid>https://masterji.top/cn/2026/11/%E4%BA%BA%E7%94%9F%E6%80%BB%E6%98%AF%E8%BF%99%E6%A0%B7/</guid>
      <description>&lt;br&gt;&#xA;&lt;link rel=&#34;stylesheet&#34; href=&#34;https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css&#34;&gt;&#xA;&lt;script src=&#34;https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js&#34;&gt;&lt;/script&gt;&#xA;&#xA;&lt;div class=&#34;music-player&#34; data-id=&#34;28710392&#34; data-server=&#34;kuwo&#34; data-type=&#34;song&#34; data-autoplay=&#34;true&#34; data-loop=&#34;all&#34; data-list-max-height=&#34;140&#34;&gt;&lt;/div&gt;&#xA;&lt;script&gt;&#xA;(() =&gt; {&#xA;  const container = document.currentScript.previousElementSibling;&#xA;  const { id, server, type, autoplay, loop, listMaxHeight } = container.dataset;&#xA;  const apiUrl = new URL(server === &#34;kuwo&#34;&#xA;    ? &#34;https://musicpay.kuwo.cn/music.pay&#34;&#xA;    : &#34;https://api.i-meto.com/meting/api&#34;);&#xA;  if (server === &#34;kuwo&#34;) {&#xA;    apiUrl.searchParams.set(&#34;op&#34;, &#34;query&#34;);&#xA;    apiUrl.searchParams.set(&#34;action&#34;, &#34;download&#34;);&#xA;    apiUrl.searchParams.set(&#34;ids&#34;, id);&#xA;  } else {&#xA;    apiUrl.searchParams.set(&#34;server&#34;, server);&#xA;    apiUrl.searchParams.set(&#34;type&#34;, type);&#xA;    apiUrl.searchParams.set(&#34;id&#34;, id);&#xA;  }&#xA;&#xA;  fetch(apiUrl)&#xA;    .then(response =&gt; {&#xA;      if (!response.ok) throw new Error(`Music metadata: HTTP ${response.status}`);&#xA;      return response.json();&#xA;    })&#xA;    .then(result =&gt; server === &#34;kuwo&#34; ? result.songs : result)&#xA;    .then(songs =&gt; {&#xA;      if (!Array.isArray(songs) || !songs.length) throw new Error(&#34;Music metadata is empty&#34;);&#xA;      const audio = songs.map(song =&gt; {&#xA;        if (server === &#34;kuwo&#34;) {&#xA;          if (String(song.id) !== id || !song.name || song.payInfo?.cannotOnlinePlay) {&#xA;            throw new Error(&#34;Kuwo song is unavailable&#34;);&#xA;          }&#xA;          const cover = song.albumPic || song.musicPic || &#34;&#34;;&#xA;          return {&#xA;            name: song.name,&#xA;            artist: song.artist || &#34;未知歌手&#34;,&#xA;            url: &#34;https://antiserver.kuwo.cn/anti.s?type=convert_url&amp;rid=MUSIC_&#34; + encodeURIComponent(id) + &#34;&amp;format=mp3&amp;response=res&#34;,&#xA;            cover: cover.replace(/^http:/, &#34;https:&#34;),&#xA;            lrc: &#34;&#34;&#xA;          };&#xA;        }&#xA;        const trackId = new URL(song.url).searchParams.get(&#34;id&#34;);&#xA;        return {&#xA;          name: song.title,&#xA;          artist: song.author,&#xA;          url: trackId&#xA;            ? `https://music.163.com/song/media/outer/url?id=${encodeURIComponent(trackId)}.mp3`&#xA;            : song.url,&#xA;          cover: song.pic,&#xA;          lrc: song.lrc&#xA;        };&#xA;      });&#xA;      const player = new APlayer({&#xA;        container,&#xA;        autoplay: autoplay === &#34;true&#34;,&#xA;        loop,&#xA;        listMaxHeight,&#xA;        lrcType: audio.some(song =&gt; song.lrc) ? 3 : 0,&#xA;        audio&#xA;      });&#xA;&#xA;      &#xA;      const bar = player.template.barWrap;&#xA;      const progress = event =&gt; {&#xA;        const point = event.changedTouches?.[0] || event.touches?.[0] || event;&#xA;        const rect = bar.getBoundingClientRect();&#xA;        return Math.max(0, Math.min(1, (point.clientX - rect.left) / rect.width));&#xA;      };&#xA;      const preview = event =&gt; {&#xA;        const fraction = progress(event);&#xA;        const time = fraction * player.duration;&#xA;        const minutes = Math.floor(time / 60);&#xA;        const seconds = Math.floor(time % 60);&#xA;        player.bar.set(&#34;played&#34;, fraction, &#34;width&#34;);&#xA;        player.template.ptime.textContent = `${String(minutes).padStart(2, &#34;0&#34;)}:${String(seconds).padStart(2, &#34;0&#34;)}`;&#xA;        player.lrc?.update(time);&#xA;        return time;&#xA;      };&#xA;      const startSeek = event =&gt; {&#xA;        event.stopImmediatePropagation();&#xA;        event.preventDefault();&#xA;        player.disableTimeupdate = true;&#xA;        preview(event);&#xA;        const touch = event.type === &#34;touchstart&#34;;&#xA;        const moveEvent = touch ? &#34;touchmove&#34; : &#34;mousemove&#34;;&#xA;        const endEvent = touch ? &#34;touchend&#34; : &#34;mouseup&#34;;&#xA;        const move = e =&gt; {&#xA;          if (e.cancelable) e.preventDefault();&#xA;          preview(e);&#xA;        };&#xA;        const end = e =&gt; {&#xA;          document.removeEventListener(moveEvent, move);&#xA;          document.removeEventListener(endEvent, end);&#xA;          if (touch) document.removeEventListener(&#34;touchcancel&#34;, cancel);&#xA;          player.seek(preview(e));&#xA;          player.disableTimeupdate = false;&#xA;        };&#xA;        const cancel = () =&gt; {&#xA;          document.removeEventListener(moveEvent, move);&#xA;          document.removeEventListener(endEvent, end);&#xA;          document.removeEventListener(&#34;touchcancel&#34;, cancel);&#xA;          player.disableTimeupdate = false;&#xA;        };&#xA;        document.addEventListener(moveEvent, move, { passive: false });&#xA;        document.addEventListener(endEvent, end);&#xA;        if (touch) document.addEventListener(&#34;touchcancel&#34;, cancel);&#xA;      };&#xA;      bar.addEventListener(&#34;mousedown&#34;, startSeek, true);&#xA;      bar.addEventListener(&#34;touchstart&#34;, startSeek, { capture: true, passive: false });&#xA;&#xA;      const volumeBar = player.template.volumeBar;&#xA;      const volumeWrap = player.template.volumeBarWrap;&#xA;      const setVolume = event =&gt; {&#xA;        const point = event.changedTouches?.[0] || event.touches?.[0] || event;&#xA;        const rect = volumeBar.getBoundingClientRect();&#xA;        player.volume(Math.max(0, Math.min(1, (rect.bottom - point.clientY) / rect.height)));&#xA;      };&#xA;      const startVolume = event =&gt; {&#xA;        event.stopImmediatePropagation();&#xA;        event.preventDefault();&#xA;        volumeWrap.classList.add(&#34;aplayer-volume-bar-wrap-active&#34;);&#xA;        setVolume(event);&#xA;        const touch = event.type === &#34;touchstart&#34;;&#xA;        const moveEvent = touch ? &#34;touchmove&#34; : &#34;mousemove&#34;;&#xA;        const endEvent = touch ? &#34;touchend&#34; : &#34;mouseup&#34;;&#xA;        const move = e =&gt; {&#xA;          if (e.cancelable) e.preventDefault();&#xA;          setVolume(e);&#xA;        };&#xA;        const end = e =&gt; {&#xA;          document.removeEventListener(moveEvent, move);&#xA;          document.removeEventListener(endEvent, end);&#xA;          if (touch) document.removeEventListener(&#34;touchcancel&#34;, cancel);&#xA;          volumeWrap.classList.remove(&#34;aplayer-volume-bar-wrap-active&#34;);&#xA;          setVolume(e);&#xA;        };&#xA;        const cancel = () =&gt; {&#xA;          document.removeEventListener(moveEvent, move);&#xA;          document.removeEventListener(endEvent, end);&#xA;          document.removeEventListener(&#34;touchcancel&#34;, cancel);&#xA;          volumeWrap.classList.remove(&#34;aplayer-volume-bar-wrap-active&#34;);&#xA;        };&#xA;        document.addEventListener(moveEvent, move, { passive: false });&#xA;        document.addEventListener(endEvent, end);&#xA;        if (touch) document.addEventListener(&#34;touchcancel&#34;, cancel);&#xA;      };&#xA;      volumeWrap.addEventListener(&#34;mousedown&#34;, startVolume, true);&#xA;      volumeWrap.addEventListener(&#34;touchstart&#34;, startVolume, { capture: true, passive: false });&#xA;    })&#xA;    .catch(error =&gt; {&#xA;      console.error(error);&#xA;      container.textContent = &#34;音乐加载失败，请稍后重试。&#34;;&#xA;    });&#xA;})();&#xA;&lt;/script&gt;&#xA;&#xA;&lt;h2 id=&#34;前言&#34;&gt;前言&lt;/h2&gt;&#xA;&lt;p&gt;这篇文章本来是发在朋友圈里的。但作为一个从小到大不得不看别人脸色生活的湖北人，发完后，我总是会胡思乱想。别人看到后会怎么想我？会不会有什么语病？标点都用对了吗？别人都发美食、美景，我发的是不是过于消极了？&lt;/p&gt;</description>
    </item>
    
    <item>
      <title>2026年中秋杂谈</title>
      <link>https://masterji.top/cn/2026/09/2026%E5%B9%B4%E4%B8%AD%E7%A7%8B%E6%9D%82%E8%B0%88/</link>
      <pubDate>Fri, 25 Sep 2026 22:34:38 +0800</pubDate>
