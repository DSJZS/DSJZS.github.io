    <item>
      <title>博客主题更改后我的一些心里话</title>
      <link>https://masterji.top/cn/2026/07/%E5%8D%9A%E5%AE%A2%E4%B8%BB%E9%A2%98%E6%9B%B4%E6%94%B9%E5%90%8E%E6%88%91%E7%9A%84%E4%B8%80%E4%BA%9B%E5%BF%83%E9%87%8C%E8%AF%9D/</link>
